# Copia esto a .env y rellénalo. El fichero .env no se sube a ningún sitio.

# El dominio donde vive la plataforma. Caddy saca el certificado solo.
DOMINIO=carnes.tu-dominio.com

# Contraseña de la base de datos. Larga y aleatoria; no se vuelve a escribir.
POSTGRES_PASSWORD=

# La clave con la que se cifran los datos de contacto de las solicitudes.
# Si se pierde, esos datos no se pueden volver a leer: guárdala aparte.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GRILL_DATA_KEY=

# El correo por el que llegan las solicitudes de acceso. Sin esto la
# plataforma funciona igual, pero no avisa: hay que mirar la consola.
GRILL_SMTP_HOST=
GRILL_SMTP_PORT=587
GRILL_SMTP_USER=
GRILL_SMTP_PASSWORD=
GRILL_MAIL_FROM=
GRILL_MAIL_TO=

# Cuántas copias de seguridad se guardan. Una al día y treinta copias es un mes
# hacia atrás, que es lo que hace falta para volver de algo que nadie vio el
# mismo día. Con 0 no se borra ninguna nunca: entonces el disco es cosa tuya.
COPIAS_GUARDAR=30

# La pasarela de pago. Son dos claves distintas y hacen falta las dos:
#   STRIPE_WEBHOOK_SECRET comprueba lo que la pasarela nos manda (recibos
#     pagados, fallados, suscripciones canceladas). Sin ella esa dirección
#     contesta que no está puesta en marcha, en vez de fingir que sí.
#   STRIPE_SECRET_KEY firma lo que le mandamos nosotros, y hoy solo sirve para
#     una cosa: parar la suscripción cuando una casa se da de baja. Sin ella la
#     baja se hace igual, pero el cobro sigue vivo y la consola del dueño lo
#     marca en rojo para que lo pare a mano.
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
